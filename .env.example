# Pinterest API
# Nectar Engine Pinterest app ID.
PINTEREST_APP_ID=1605925
# Available after Pinterest approves Trial access.
PINTEREST_APP_SECRET=
# Must exactly match the Redirect URI configured in Pinterest.
PINTEREST_REDIRECT_URI=https://nectar-engine.vercel.app/api/pinterest/callback
# Long random secret used to encrypt the browser session containing Pinterest tokens.
PINTEREST_COOKIE_SECRET=

# Pinterest OAuth scopes used by the Nectar Engine control room:
# boards:read boards:write pins:read pins:write user_accounts:read

# Existing app secrets/database variables remain required by the rest of Nectar Engine.
